# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# Your data room
ROOM_TITLE=Keel Data Room
ROOM_DESC=

# Admin secret — your admin panel URL (keep it secret!)
ADMIN_SECRET=change-this-to-something-secret

# Your email — you get notified here when someone visits
OWNER_EMAIL=

# Email (SMTP) — for visitor notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Keel Data Room <noreply@keel.sale>

# Your public URL
BASE_URL=http://localhost:3000