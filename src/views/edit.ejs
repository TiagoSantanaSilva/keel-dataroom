<% pageTitle = room.name %><%- include('head') %>
<div class="mb-4">
  <a href="/dashboard" class="text-decoration-none text-muted">
    <i class="bi bi-arrow-left me-1"></i>Back to rooms
  </a>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <h2 class="fw-bold mb-1" style="color: #0a1628;"><%= room.name %></h2>
            <% if (room.description) { %>
              <p class="text-muted mb-0"><%= room.description %></p>
            <% } %>
          </div>
          <form method="POST" action="/dashboard/<%= room.id %>/delete"
                onsubmit="return confirm('Delete this data room permanently? This action cannot be undone.')">
            <button type="submit" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-trash me-1"></i>Delete
            </button>
          </form>
        </div>

        <div class="p-3 mb-3 rounded-3" style="background: #f0f7ff; border: 1px solid #dbeafe;">
          <label class="fw-medium small text-muted mb-1">Share this link with viewers</label>
          <div class="input-group">
            <input type="text" class="form-control bg-white" id="shareUrl" value="<%= shareUrl %>" readonly>
            <button class="btn btn-keel" onclick="copyUrl()">
              <i class="bi bi-clipboard me-1"></i>Copy
            </button>
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form method="POST" action="/dashboard/<%= room.id %>/update" class="row g-2">
          <div class="col-md-8">
            <input type="text" name="name" class="form-control" value="<%= room.name %>" required>
          </div>
          <div class="col-md-4">
            <button type="submit" class="btn btn-keel w-100">
              <i class="bi bi-check-lg me-1"></i>Rename
            </button>
          </div>
          <div class="col-12">
            <textarea name="description" class="form-control" rows="2" placeholder="Add description…"><%= room.description %></textarea>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow-sm mb-4" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3" style="color: #0a1628;">
          <i class="bi bi-upload me-2" style="color: #2563eb;"></i>Upload Documents
        </h5>
        <form method="POST" action="/dashboard/<%= room.id %>/upload" enctype="multipart/form-data">
          <div class="mb-3">
            <input type="file" name="file" class="form-control form-control-lg" required>
            <div class="form-text">PDF, images, presentations, spreadsheets, docs</div>
          </div>
          <button type="submit" class="btn btn-keel">
            <i class="bi bi-upload me-2"></i>Upload File
          </button>
        </form>
      </div>
    </div>

    <div class="card shadow-sm mb-4" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3" style="color: #0a1628;">
          <i class="bi bi-file-earmark me-2" style="color: #2563eb;"></i>Documents
          <span class="badge badge-doc ms-2 rounded-pill"><%= documents.length %></span>
        </h5>
        <% if (documents.length === 0) { %>
          <div class="text-center py-4">
            <i class="bi bi-file-earmark-plus" style="font-size: 2.5rem; color: #cbd5e1;"></i>
            <p class="text-muted mt-2 mb-0">No documents yet. Upload your first file above.</p>
          </div>
        <% } else { %>
          <% documents.forEach(doc => { %>
          <div class="file-card p-3 mb-2 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <i class="bi bi-file-earmark me-3" style="font-size: 1.5rem; color: #64748b;"></i>
              <div>
                <div class="fw-medium"><%= doc.original_name %></div>
                <small class="text-muted">
                  <% if (doc.file_size > 1048576) { %>
                    <%= (doc.file_size / 1048576).toFixed(1) %> MB
                  <% } else { %>
                    <%= (doc.file_size / 1024).toFixed(0) %> KB
                  <% } %>
                  · <%= new Date(doc.uploaded_at).toLocaleDateString() %>
                </small>
              </div>
            </div>
            <form method="POST" action="/dashboard/<%= room.id %>/documents/<%= doc.id %>/delete"
                  onsubmit="return confirm('Remove this file from the data room?')">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-x-lg"></i>
              </button>
            </form>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm mb-4" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3" style="color: #0a1628;">
          <i class="bi bi-people-fill me-2" style="color: #2563eb;"></i>Visitors
          <span class="badge badge-visitor ms-2 rounded-pill"><%= visitors.length %></span>
        </h5>
        <% if (visitors.length === 0) { %>
          <div class="text-center py-4">
            <i class="bi bi-person-plus" style="font-size: 2.5rem; color: #cbd5e1;"></i>
            <p class="text-muted mt-2 mb-0">No visitors yet. Share your data room link!</p>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% visitors.forEach(v => { %>
            <div class="p-3 border-bottom" style="border-color: #f1f5f9 !important;">
              <div class="d-flex align-items-center">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2"
                     style="width: 36px; height: 36px; min-width: 36px;">
                  <i class="bi bi-person-fill text-muted"></i>
                </div>
                <div>
                  <div class="fw-medium small"><%= v.email %></div>
                  <% if (v.name) { %><div class="text-muted small"><%= v.name %></div><% } %>
                  <div class="text-muted" style="font-size: 0.75rem;">
                    <i class="bi bi-clock me-1"></i><%= new Date(v.viewed_at).toLocaleString() %>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% scripts = ['function copyUrl(){var e=document.getElementById(\"shareUrl\");e.select();navigator.clipboard.writeText(e.value).then(function(){var t=e.nextElementSibling;t.innerHTML=\"<i class=\\\\\"bi bi-check-lg me-1\\\\\"></i>Copied!\";setTimeout(function(){t.innerHTML=\"<i class=\\\\\"bi bi-clipboard me-1\\\\\"></i>Copy\"},2e3)})}'] %><%- include('foot') %>