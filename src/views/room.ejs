<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= roomTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --keel-primary: #000000;
      --keel-accent: #B8944F;
      --keel-background: #EEEEEE;
      --keel-text: #1A1E2F;
      --keel-text-secondary: #5A5E6F;
    }
    body {
      background: var(--keel-background);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      color: var(--keel-text);
    }
    .top-logo {
      position: fixed;
      top: 20px;
      left: 20px;
      width: 140px;
      height: 140px;
      z-index: 1000;
    }
    .top-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .page-title {
      text-align: center;
      margin-top: 40px;
      margin-bottom: 40px;
    }
    .page-title h1 {
      font-weight: 700;
      font-size: 32px;
      color: var(--keel-text);
    }
    .link-card {
      background: white;
      border: 1px solid #E5E0D5;
      border-radius: 12px;
      transition: all 0.15s;
    }
    .link-card:hover {
      border-color: var(--keel-accent);
      box-shadow: 0 2px 8px rgba(184,148,79,0.12);
    }
    .link-card a {
      text-decoration: none;
      color: inherit;
    }
    .link-card a:hover .link-title {
      color: var(--keel-accent);
    }
    .btn-keel { background: var(--keel-primary); color: white; border: none; font-weight: 600; }
    .btn-keel:hover { background: var(--keel-accent); color: white; }
  </style>
</head>
<body>
  <!-- Top Left Logo -->
  <div class="top-logo">
    <img src="assets/icons/keel-logo-frame40.png" alt="Keel" />
  </div>

  <!-- Centered Title -->
  <div class="page-title">
    <h1><%= roomTitle %></h1>
    <p style="color: var(--keel-text-secondary); margin-top: 8px;">
      <i class="bi bi-person-circle me-1"></i><%= visitorEmail %>
    </p>
  </div>

  <div class="container py-4">
    <% if (roomDesc) { %>
    <div class="mb-4"><p class="text-muted mb-0"><%= roomDesc %></p></div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold mb-0" style="color: var(--keel-text);">
        <i class="bi bi-link-45deg me-2" style="color: var(--keel-accent);"></i><%= items.length %> link<%= items.length !== 1 ? 's' : '' %>
      </h5>
    </div>

    <% if (items.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-link-45deg" style="font-size: 4rem; color: #D1C4B5;"></i>
      <p style="color: var(--keel-text-secondary); margin-top: 12px;">This data room has no links yet.</p>
    </div>
    <% } else { %>
    <div class="row g-3">
      <% items.forEach(item => { %>
      <div class="col-md-6 col-lg-4">
        <a href="<%= item.url %>" target="_blank" rel="noopener">
          <div class="link-card p-4 h-100">
            <div class="d-flex flex-column h-100">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-link-45deg me-2" style="font-size: 1.5rem; color: var(--keel-accent);"></i>
                <span class="link-title fw-bold" style="color: var(--keel-text); font-size: 1rem;"><%= item.name %></span>
              </div>
              <% if (item.description) { %>
                <p style="color: var(--keel-text-secondary); font-size: 0.875rem; margin-bottom: 8px;"><%= item.description %></p>
              <% } %>
              <div class="mt-auto">
                <span style="color: var(--keel-text-secondary); font-size: 0.875rem; word-break: break-all;"><%= item.url %></span>
              </div>
              <div class="mt-2">
                <span class="btn btn-sm btn-keel w-100">
                  <i class="bi bi-box-arrow-up-right me-1"></i>Open
                </span>
              </div>
            </div>
          </div>
        </a>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</body>
</html>