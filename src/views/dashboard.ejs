<% pageTitle = 'Dashboard' %><%- include('head') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold" style="color: #0a1628;">My Data Rooms</h2>
    <p class="text-muted mb-0"><%= rooms.length %> data room<%= rooms.length !== 1 ? 's' : '' %></p>
  </div>
  <a href="/dashboard/create" class="btn btn-keel btn-lg">
    <i class="bi bi-plus-lg me-2"></i>New Data Room
  </a>
</div>

<% if (rooms.length === 0) { %>
<div class="text-center" style="margin-top: 100px;">
  <i class="bi bi-folder-plus" style="font-size: 4rem; color: #cbd5e1;"></i>
  <h5 class="mt-3 text-muted">No data rooms yet</h5>
  <p class="text-muted mb-4">Create your first data room to start sharing documents</p>
  <a href="/dashboard/create" class="btn btn-keel btn-lg">
    <i class="bi bi-plus-lg me-2"></i>Create Data Room
  </a>
</div>
<% } else { %>
<div class="row g-4">
  <% rooms.forEach(room => { %>
  <div class="col-md-6 col-lg-4">
    <a href="/dashboard/<%= room.id %>/edit" class="text-decoration-none">
      <div class="card card-room h-100 p-4" style="background: white;">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <i class="bi bi-folder-fill" style="font-size: 2rem; color: #2563eb;"></i>
          </div>
          <div class="dropdown">
            <button class="btn btn-sm" style="border: none; background: none;" data-bs-toggle="dropdown">
              <i class="bi bi-three-dots" style="color: #94a3b8;"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/dashboard/<%= room.id %>/edit">
                <i class="bi bi-pencil me-2"></i>Edit
              </a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="POST" action="/dashboard/<%= room.id %>/delete"
                      onsubmit="return confirm('Delete this data room and all its files?')">
                  <button class="dropdown-item text-danger" type="submit">
                    <i class="bi bi-trash me-2"></i>Delete
                  </button>
                </form>
              </li>
            </ul>
          </div>
        </div>
        <h5 class="fw-bold mb-1" style="color: #1e293b;"><%= room.name %></h5>
        <% if (room.description) { %>
          <p class="text-muted small mb-2"><%= room.description %></p>
        <% } %>
        <div class="mt-auto pt-3 border-top" style="border-color: #f1f5f9 !important;">
          <div class="d-flex gap-3">
            <span class="badge badge-doc px-3 py-2 rounded-pill">
              <i class="bi bi-file-earmark me-1"></i><%= room.doc_count %> file<%= room.doc_count !== 1 ? 's' : '' %>
            </span>
            <span class="badge badge-visitor px-3 py-2 rounded-pill">
              <i class="bi bi-eye me-1"></i><%= room.visitor_count %> visit<%= room.visitor_count !== 1 ? 's' : '' %>
            </span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <% }) %>
</div>
<% } %>
<%- include('foot') %>