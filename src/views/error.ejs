<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error — Keel Data Room</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background: #f8fafc;">
  <div class="text-center">
    <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #94a3b8;"></i>
    <h4 class="fw-bold mt-3" style="color: #0a1628;">Oops</h4>
    <p class="text-muted"><%= message %></p>
    <a href="/" class="btn btn-keel mt-2">Go home</a>
  </div>
  <style>.btn-keel { background: #2563eb; color: white; border: none; padding: 10px 24px; border-radius: 8px; } .btn-keel:hover { background: #1d4ed8; color: white; }</style>
</body>
</html>