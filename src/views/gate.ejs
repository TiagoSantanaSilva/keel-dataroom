<% pageTitle = 'Secure Data Room' %><%- include('head') %>
<div class="row justify-content-center" style="margin-top: 80px;">
  <div class="col-md-5">
    <div class="text-center mb-4">
      <i class="bi bi-lock-fill" style="font-size: 3rem; color: #0a1628; opacity: 0.8;"></i>
      <h2 class="fw-bold mt-3" style="color: #0a1628;"><%= roomTitle %></h2>
      <% if (roomDesc) { %>
        <p class="text-muted"><%= roomDesc %></p>
      <% } %>
      <p class="text-muted small mt-2 mb-0">
        <i class="bi bi-shield-check me-1"></i>Secure data room · Enter your email to access
      </p>
    </div>
    <div class="card shadow" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>
        <form method="POST" action="/">
          <div class="mb-3">
            <label class="form-label fw-medium">Email address</label>
            <input type="email" name="email" class="form-control form-control-lg"
                   placeholder="you@company.com" required autofocus
                   oninvalid="this.setCustomValidity('Please enter a valid email')"
                   oninput="this.setCustomValidity('')">
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Name <span class="text-muted">(optional)</span></label>
            <input type="text" name="name" class="form-control" placeholder="Your full name">
          </div>
          <button type="submit" class="btn btn-keel w-100 btn-lg">
            <i class="bi bi-unlock me-2"></i>Access Data Room
          </button>
        </form>
      </div>
    </div>
    <p class="text-center text-muted small mt-3">
      <i class="bi bi-shield-lock me-1"></i>Your email will be shared with the data room owner
    </p>
  </div>
</div>
<%- include('foot') %>