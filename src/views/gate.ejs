<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= room.name %> — Keel Data Room</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --keel-navy: #0a1628;
      --keel-blue: #2563eb;
    }
    body {
      background: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .gate-card {
      max-width: 440px;
      width: 100%;
    }
    .brand-logo {
      color: var(--keel-navy);
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }
    .btn-keel {
      background: var(--keel-blue);
      color: white;
      border: none;
      font-weight: 500;
      padding: 12px 24px;
    }
    .btn-keel:hover { background: #1d4ed8; color: white; }
  </style>
</head>
<body>
  <div class="gate-card px-4">
    <div class="text-center mb-4">
      <i class="bi bi-lock-fill" style="font-size: 2.5rem; color: var(--keel-navy); opacity: 0.8;"></i>
      <h4 class="fw-bold mt-3" style="color: var(--keel-navy);"><%= room.name %></h4>
      <% if (room.description) { %>
        <p class="text-muted mb-0"><%= room.description %></p>
      <% } %>
      <p class="text-muted small mt-2 mb-0">
        <i class="bi bi-shield-check me-1"></i>Secure data room · Enter your email to access
      </p>
    </div>

    <div class="card shadow" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>
        <form method="POST" action="/room/<%= room.slug %>">
          <div class="mb-3">
            <label class="form-label fw-medium">Email address</label>
            <input type="email" name="email" class="form-control form-control-lg"
                   placeholder="you@company.com" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Name <span class="text-muted">(optional)</span></label>
            <input type="text" name="name" class="form-control" placeholder="Your full name">
          </div>
          <button type="submit" class="btn btn-keel w-100">
            <i class="bi bi-unlock me-2"></i>Access Data Room
          </button>
        </form>
      </div>
    </div>

    <p class="text-center text-muted small mt-3">
      <i class="bi bi-shield-lock me-1"></i>Your email will be shared with the data room owner
    </p>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>