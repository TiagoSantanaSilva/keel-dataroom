<% pageTitle = 'New Data Room' %><%- include('head') %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="mb-4">
      <a href="/dashboard" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i>Back to rooms
      </a>
      <h2 class="fw-bold mt-2" style="color: #0a1628;">New Data Room</h2>
      <p class="text-muted">Create a secure space for your documents</p>
    </div>
    <div class="card shadow-sm" style="border: none; border-radius: 16px;">
      <div class="card-body p-4">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/dashboard/create">
          <div class="mb-3">
            <label class="form-label fw-medium">Data Room Name</label>
            <input type="text" name="name" class="form-control form-control-lg"
                   placeholder="e.g. Q4 2026 Investor Materials" required autofocus>
          </div>
          <div class="mb-4">
            <label class="form-label fw-medium">Description <span class="text-muted">(optional)</span></label>
            <textarea name="description" class="form-control" rows="3"
                      placeholder="Briefly describe what's in this data room…"></textarea>
          </div>
          <button type="submit" class="btn btn-keel btn-lg w-100">
            <i class="bi bi-folder-plus me-2"></i>Create Data Room
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('foot') %>